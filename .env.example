# ===========================================================================
# UAT Test Intelligence Platform — environment template
# Copy to `.env` and adjust. All values have safe defaults for local/demo use.
# ===========================================================================

# --- App -------------------------------------------------------------------
APP_ENV=demo                          # development | demo | production
API_TOKEN=dev-token                   # Bearer token for /api/v1 (set a strong one in prod)
LOG_FORMAT=text                       # text | json

# --- Database --------------------------------------------------------------
POSTGRES_USER=uat
POSTGRES_PASSWORD=uat
POSTGRES_DB=uat_test_intelligence
# The api container builds DATABASE_URL as postgresql://<user>:<pw>@db:5432/<db>.

# --- Test frameworks -------------------------------------------------------
API_RUNNER_URL=http://api-tests:5001
WEB_RUNNER_URL=http://web-tests:6000

# --- LLM (optional, default = deterministic heuristic analysis) ------------
LLM_PROVIDER=none                     # none | openai | anthropic
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# --- Azure DevOps (required only for real sync; demo uses seeded data) -----
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=
# Story role: which work item type drives coverage/readiness/matrix/velocity.
# Azure "Basic" process has no User Story -> set AZURE_STORY_TYPE=Epic (or Issue).
AZURE_STORY_TYPE=User Story
# Work item types treated as defects on sync (comma-separated; Basic tracks bugs as Issues).
AZURE_DEFECT_TYPES=Bug,Issue
# Field holding acceptance criteria (Basic process has no built-in AC field -> point this at a custom field).
AZURE_ACCEPTANCE_CRITERIA_FIELD=Microsoft.VSTS.Common.AcceptanceCriteria
# Custom field flagging a story's test effort (values below). Empty/absent = manual.
# Create an "Automation Status" custom field in Azure to use this.
AZURE_AUTOMATION_STATUS_FIELD=Custom.AutomationStatus
AZURE_AUTOMATION_AUTOMATED_VALUE=Automated
AZURE_AUTOMATION_MANUAL_VALUE=Not Automated
# Boolean custom field marking stories that must deliver test output.
# False = non-test effort (e.g. environment setup) excluded from coverage;
# empty/True = acceptance criteria required. Create "Acceptance Test Required".
AZURE_ACCEPTANCE_TEST_REQUIRED_FIELD=Custom.AcceptanceTestRequired

# --- Report generation -----------------------------------------------------
REPORT_ENGINE=manual                  # weasyprint | manual (HTML-copy fallback)
REPORT_COMPANY_NAME=Acme Corp
REPORT_PRIMARY_COLOR=#0f4c81
REPORT_SECONDARY_COLOR=#6c757d
REPORT_FOOTER=Confidential - generated by UAT Test Intelligence Platform

# --- Notifications (email; disabled by default) ----------------------------
NOTIFICATIONS_ENABLED=false
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=uat@example.com
NOTIFICATION_RECIPIENTS=
