# ===========================================================================
# UAT Test Intelligence Platform — environment template
# Copy to `.env` and adjust. All values have safe defaults for local/demo use.
# ===========================================================================

# --- App -------------------------------------------------------------------
APP_ENV=demo                          # development | demo | production
API_TOKEN=dev-token                   # Bearer token for /api/v1 (set a strong one in prod)
LOG_FORMAT=text                       # text | json

# --- Database --------------------------------------------------------------
POSTGRES_USER=uat
POSTGRES_PASSWORD=uat
POSTGRES_DB=uat_test_intelligence
# The api container builds DATABASE_URL as postgresql://<user>:<pw>@db:5432/<db>.

# --- Test frameworks -------------------------------------------------------
API_RUNNER_URL=http://api-tests:5001
WEB_RUNNER_URL=http://web-tests:6000

# --- LLM (optional, default = deterministic heuristic analysis) ------------
LLM_PROVIDER=none                     # none | openai | anthropic
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# --- Azure DevOps (required only for real sync; demo uses seeded data) -----
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PROJECT=
AZURE_DEVOPS_PAT=

# --- Report generation -----------------------------------------------------
REPORT_ENGINE=manual                  # weasyprint | manual (HTML-copy fallback)
REPORT_COMPANY_NAME=Acme Corp
REPORT_PRIMARY_COLOR=#0f4c81
REPORT_SECONDARY_COLOR=#6c757d
REPORT_FOOTER=Confidential - generated by UAT Test Intelligence Platform

# --- Notifications (email; disabled by default) ----------------------------
NOTIFICATIONS_ENABLED=false
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=uat@example.com
NOTIFICATION_RECIPIENTS=
